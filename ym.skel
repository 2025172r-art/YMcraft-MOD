 BG.forEach(function(g,i){var o=document.createElement("option");o.value=i;o.textContent=g[0]+"("+(Object.keys(YMD[g[1]]||{}).length*g[2].length).toLocaleString()+")";sel.appendChild(o)});sel.value=bg;
 var q=css(document.createElement("input"),"flex:1;min-width:140px;padding:5px;font:13px sans-serif");q.placeholder="検索(例: ダイヤ、ゾンビ、5x5、全員)";q.value=bq;
