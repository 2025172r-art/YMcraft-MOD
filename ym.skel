["items","アイテム・ブロック全種",function(id,v){return "/give @s minecraft:"+id+(v&&v!=="1"?" "+v:"")},"数"],
["ents","モブ・エンティティ全種",function(id){return "/summon minecraft:"+id+" ~ ~ ~"},""],
["bio","バイオームを探す",function(id){return "/locate biome minecraft:"+id},""],
["ench","エンチャント(手持ち)",function(id,v){return "/enchant @s minecraft:"+id+" "+(v||"1")},"レベル"],
["eff","効果を付ける",function(id,v){return "/effect give @s minecraft:"+id+" 99999 "+(v||"0")+" true"},"強さ"],
["effclr","効果を消す",function(id){return "/effect clear @s minecraft:"+id},""],
["rules","ゲームルール(オン/オフ)",null,""]];
var ac=0,aq="",av="";
function allView(){
 var n=css(document.createElement("div"),"font:12px/1.5 sans-serif;color:#bbb;margin-bottom:6px");n.textContent="ゲームに入っている全種類から作ります。押すとコピー → T で貼り付けて Enter。";panel.appendChild(n);
 var bar=css(document.createElement("div"),"display:flex;gap:6px;margin-bottom:6px;flex-wrap:wrap");
 var sel=document.createElement("span");lang="ja";
 var q=css(document.createElement("input"),"flex:1;min-width:120px;padding:5px;font:13px sans-serif");q.placeholder="検索(日本語・英語どちらでも)";q.value=aq;
 var vv=css(document.createElement("input"),"width:90px;padding:5px;font:13px sans-serif");vv.value=av;
 [q,vv].forEach(function(e){["keydown","keyup","keypress"].forEach(function(k){e.addEventListener(k,function(ev){ev.stopPropagation()})})});
 bar.appendChild(sel);bar.appendChild(q);bar.appendChild(vv);panel.appendChild(bar);
 var cnt=css(document.createElement("div"),"font:12px sans-serif;color:#9fd;margin-bottom:4px");panel.appendChild(cnt);
 var box=css(document.createElement("div"),"max-height:min(48vh,340px);overflow:auto;padding-right:4px");panel.appendChild(box);
 function draw(){var c=ALLC[ac];vv.style.display=c[3]?"":"none";vv.placeholder=c[3]||"";box.innerHTML="";
  var src=c[0]==="rules"?YMD.rules:c[0]==="effclr"?YMD.eff:YMD[c[0]];var qq=aq.trim().toLowerCase();var ids=Object.keys(src);var shown=0,row=css(document.createElement("div"),"display:flex;flex-wrap:wrap;gap:6px");
  ids.forEach(function(id){var nm=src[id];if(qq&&nm.toLowerCase().indexOf(qq)<0&&id.indexOf(qq)<0)return;shown++;if(shown>400)return;
   if(c[0]==="rules"){["true","false"].forEach(function(b){cmdBtn([nm+(b==="true"?" ON":" OFF"),"/gamerule "+id+" "+b],row)})}
   else cmdBtn([nm,c[2](id,av.trim())],row)});
  box.appendChild(row);cnt.textContent=shown+"件"+(shown>400?"(先頭400件を表示。検索で絞ってください)":"")}
 sel.onchange=function(){ac=+sel.value;draw()};q.oninput=function(){aq=q.value;draw()};vv.oninput=function(){av=vv.value;draw()};draw()}
function synView(){var n=css(document.createElement("div"),"font:12px/1.5 sans-serif;color:#bbb;margin-bottom:6px");n.textContent="本家のコマンドの使い方の見本です。押すとコピー。名前などの部分は、自分用に書き換えてから使ってください。";panel.appendChild(n);
 var q=css(document.createElement("input"),"width:100%;box-sizing:border-box;padding:6px;margin-bottom:6px;font:13px sans-serif");q.placeholder="検索(例: execute、スコア、ボス)";q.value=aq;
 ["keydown","keyup","keypress"].forEach(function(k){q.addEventListener(k,function(ev){ev.stopPropagation()})});panel.appendChild(q);
 var box=css(document.createElement("div"),"max-height:min(52vh,370px);overflow:auto");panel.appendChild(box);
 function draw(){box.innerHTML="";var qq=aq.trim().toLowerCase(),row=css(document.createElement("div"),"display:flex;flex-wrap:wrap;gap:6px");
  SYN.forEach(function(s){var t=s[0]+" "+s[1]+" "+s[2];if(qq&&t.toLowerCase().indexOf(qq)<0)return;cmdBtn([s[2]+" — "+s[1].slice(0,44),s[1]],row)});box.appendChild(row)}
 q.oninput=function(){aq=q.value;draw()};draw()}

var cq="",cs=0;
function loadCust(){try{return JSON.parse(window.localStorage.getItem("ymcraft_cmds")||"[]")}catch(e){return[]}}
function saveCust(a){try{window.localStorage.setItem("ymcraft_cmds",JSON.stringify(a))}catch(e){}}
var seq={};
function copy(t,b,label){var done=function(){var o=label;b.textContent="コピーしました ✓";setTimeout(function(){b.textContent=o},1200)};
 try{navigator.clipboard.writeText(t).then(done,function(){fallback(t,done)})}catch(e){fallback(t,done)}}
function cmdBtn(c,row){var b=css(document.createElement("button"),"font:12px sans-serif;padding:5px 9px;cursor:pointer;text-align:left");b.title=c[1];b.textContent=c[0];
 b.onclick=function(){var lines=String(c[1]).split("\n").filter(function(x){return x.trim()});var k=seq[c[0]]||0;var t=lines[k%lines.length];seq[c[0]]=k+1;
  copy(t,b,c[0]+(lines.length>1?"("+((k%lines.length)+1)+"/"+lines.length+")":""))};row.appendChild(b)}
function cmdView(){
 if(tab==="all"){allView();return}if(tab==="syn"){synView();return}
 var T=tab==="cust"?null:CM[tab];
 var note=css(document.createElement("div"),"font:12px/1.5 sans-serif;color:#bbb;margin-bottom:6px");
 note.textContent="ボタンを押すとコピーされます。ゲーム内で T を押してチャットを開き、貼り付けて(Ctrl+V)Enter。チートが使えるワールドで使えます。";panel.appendChild(note);
 if(T){var q=css(document.createElement("input"),"width:100%;box-sizing:border-box;padding:6px;margin-bottom:6px;font:13px sans-serif");q.placeholder="検索(例: ダイヤ、時間、ハート)";q.value=cq;
  q.oninput=function(){cq=q.value;draw()};["keydown","keyup","keypress"].forEach(function(n){q.addEventListener(n,function(ev){ev.stopPropagation()})});panel.appendChild(q)}
 var box=css(document.createElement("div"),"max-height:min(56vh,400px);overflow:auto;padding-right:4px");panel.appendChild(box);
 function draw(){box.innerHTML="";
  if(!T){custView(box);return}
  var n=0,qq=cq.trim().toLowerCase();
  T.forEach(function(g){var items=g[1].filter(function(c){return!qq||c[0].toLowerCase().indexOf(qq)>=0||c[1].toLowerCase().indexOf(qq)>=0||g[0].toLowerCase().indexOf(qq)>=0});if(!items.length)return;n+=items.length;
   var t=css(document.createElement("div"),"font:bold 13px sans-serif;margin:8px 0 4px;color:#9fd");t.textContent=g[0]+" ("+items.length+")";box.appendChild(t);
   var row=css(document.createElement("div"),"display:flex;flex-wrap:wrap;gap:6px");items.forEach(function(c){cmdBtn(c,row)});box.appendChild(row)});
  if(!n){var e=css(document.createElement("div"),"padding:10px;color:#bbb;font:13px sans-serif");e.textContent="見つかりません";box.appendChild(e)}}
 draw()}
function custView(box){var L=loadCust();
 var f=css(document.createElement("div"),"display:flex;flex-direction:column;gap:6px;margin-bottom:8px");
 var nm=css(document.createElement("input"),"padding:6px;font:13px sans-serif");nm.placeholder="名前(例: 我が家へ帰る)";
 var cm=css(document.createElement("textarea"),"padding:6px;font:13px sans-serif;height:64px");cm.placeholder="コマンド(1行に1つ。複数行にすると、押すたびに次の行をコピー)\n例: /tp @s 100 70 -200";
 [nm,cm].forEach(function(e){["keydown","keyup","keypress"].forEach(function(n){e.addEventListener(n,function(ev){ev.stopPropagation()})});f.appendChild(e)});
 var br=css(document.createElement("div"),"display:flex;gap:6px;flex-wrap:wrap");
 function mb(t,fn){var b=css(document.createElement("button"),"font:12px sans-serif;padding:5px 10px;cursor:pointer");b.textContent=t;b.onclick=fn;br.appendChild(b)}
 mb("追加して保存",function(){if(!nm.value.trim()||!cm.value.trim())return;L.push([nm.value.trim(),cm.value.replace(/\r/g,"").trim()]);saveCust(L);build()});
 mb("書き出し(コピー)",function(){var t=JSON.stringify({ymcraft_pack:1,items:L});try{navigator.clipboard.writeText(t)}catch(e){fallback(t,function(){})}});
 mb("貼り付けて取り込み",function(){var t=window.prompt("書き出したコマンドパックの文字列を貼り付けてください");if(!t)return;try{var o=JSON.parse(t);if(o&&o.items){o.items.forEach(function(i){if(i&&i[0]&&i[1])L.push([String(i[0]),String(i[1])])});saveCust(L);build()}}catch(e){window.alert("読み込めませんでした")}});
 f.appendChild(br);box.appendChild(f);
 var row=css(document.createElement("div"),"display:flex;flex-wrap:wrap;gap:6px");
 L.forEach(function(c,i){var w=css(document.createElement("span"),"display:inline-flex;gap:2px");cmdBtn(c,w);var d=css(document.createElement("button"),"font:12px sans-serif;cursor:pointer;padding:5px 7px");d.textContent="✕";d.title="削除";d.onclick=function(){if(window.confirm("「"+c[0]+"」を削除しますか?")){L.splice(i,1);saveCust(L);build()}};w.appendChild(d);row.appendChild(w)});
 box.appendChild(row);if(!L.length){var e=css(document.createElement("div"),"padding:6px;color:#bbb;font:12px sans-serif");e.textContent="まだありません。上で名前とコマンドを入れて追加できます。書き出した文字列を友だちに送ると、同じコマンドパックを使えます。";box.appendChild(e)}}
function fallback(t,cb){try{var a=document.createElement("textarea");a.value=t;a.style.cssText="position:fixed;left:-999px";document.body.appendChild(a);a.select();document.execCommand("copy");a.remove();cb()}catch(e){}}



/* ---- ショートカット無効化(Ctrl+W で閉じてしまう事故を防ぐ) ---- */
var noShort=true;try{noShort=window.localStorage.getItem("ymcraft_noshort")!=="0"}catch(e){}
window.ymSetNoShort=function(v){noShort=v;try{window.localStorage.setItem("ymcraft_noshort",v?"1":"0")}catch(e){}tryLock()};
function tryLock(){try{if(noShort&&navigator.keyboard&&navigator.keyboard.lock&&document.fullscreenElement)navigator.keyboard.lock().catch(function(){});else if(!noShort&&navigator.keyboard&&navigator.keyboard.unlock)navigator.keyboard.unlock()}catch(e){}}
document.addEventListener("fullscreenchange",tryLock);document.addEventListener("pointerlockchange",tryLock);
window.addEventListener("keydown",function(e){if(!noShort)return;
 var k=(e.key||"").toLowerCase();
 if((e.ctrlKey||e.metaKey)&&k!=="control"&&k!=="meta"){if(e.target&&(e.target.tagName==="INPUT"||e.target.tagName==="TEXTAREA"||e.target.tagName==="SELECT")&&"cvxazy".indexOf(k)>=0)return;
  if(k==="c"||k==="v"||k==="x"||k==="a")return;e.preventDefault()}
 else if(/^F([1-9]|1[0-2])$/.test(e.key||"")&&e.key!=="F11"&&e.key!=="F9"){e.preventDefault()}
},true);
window.addEventListener("beforeunload",function(e){if(!noShort)return;e.preventDefault();e.returnValue="";return ""});
/* ---- 見た目フィルター と ズーム(Cを押している間) ---- */

(function(){try{var st=document.createElement("style");st.textContent="#ymp button{transition:filter .15s,transform .1s,box-shadow .15s;box-shadow:0 1px 3px rgba(0,0,0,.5)}#ymp button:hover{filter:brightness(1.3);box-shadow:0 0 8px rgba(212,175,55,.6)}#ymp button:active{transform:translateY(1px) scale(.97)}#ymp select,#ymp input{border-radius:5px;background:#222;color:#fff;border:1px solid #777}#ymp ::-webkit-scrollbar{width:9px;height:9px}#ymp ::-webkit-scrollbar-thumb{background:#c9a24b;border-radius:5px}#ymp ::-webkit-scrollbar-track{background:#1a1a1a}";document.documentElement.appendChild(st);
var sv=document.createElementNS("http://www.w3.org/2000/svg","svg");sv.setAttribute("width","0");sv.setAttribute("height","0");sv.style.cssText="position:absolute;pointer-events:none";
sv.innerHTML='<filter id="ym-sharp" color-interpolation-filters="sRGB"><feConvolveMatrix order="3" preserveAlpha="true" kernelMatrix="0 -.5 0 -.5 3 -.5 0 -.5 0"/></filter><filter id="ym-sharp2" color-interpolation-filters="sRGB"><feConvolveMatrix order="3" preserveAlpha="true" kernelMatrix="-.3 -.6 -.3 -.6 4.8 -.6 -.3 -.6 -.3"/></filter>';document.documentElement.appendChild(sv)}catch(e){}})();
var LOOKS=[["ふつう",""],["鮮やか","saturate(1.3) contrast(1.06)"],["やわらか","saturate(.88) brightness(1.06) contrast(.96)"],["夕焼け","sepia(.28) saturate(1.25) hue-rotate(-8deg)"],["くっきり","contrast(1.15) saturate(1.1)"],["高画質(風景)","url(#ym-sharp) contrast(1.08) saturate(1.22) brightness(1.03)"],["超シャープ(重い)","url(#ym-sharp2) contrast(1.1) saturate(1.25)"],["シネマ","contrast(1.18) saturate(1.12) sepia(.12) brightness(.96)"],["ファンタジー","saturate(1.45) contrast(1.08) hue-rotate(-6deg) brightness(1.05)"],["さわやか","saturate(1.3) brightness(1.1) hue-rotate(4deg) contrast(1.04)"]],lk=0,zoomOn=0;
try{lk=parseInt(window.localStorage.getItem("ymcraft_look")||"0")||0;if(lk<0||lk>=LOOKS.length)lk=0}catch(e){}
function applyLook(){var c=cv();if(c)c.style.filter=LOOKS[lk][1]||""}
window.ymSetLook=function(i){lk=i;try{window.localStorage.setItem("ymcraft_look",String(i))}catch(e){}applyLook();if(window.ymRefreshPanel)window.ymRefreshPanel()};
window.ymLook=function(){return lk};
