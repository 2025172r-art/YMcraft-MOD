var zBase=0;function zDpr(on){try{if(on){zBase=window.devicePixelRatio||1;var v=Math.min(8,Math.max(zBase*2.6*1.25,3.5),Math.floor(8192/Math.max(window.innerWidth,1)*10)/10);if(v<zBase)v=zBase;Object.defineProperty(window,"devicePixelRatio",{configurable:true,get:function(){return v}})}else if(zBase){var b=zBase;zBase=0;Object.defineProperty(window,"devicePixelRatio",{configurable:true,get:function(){return b}})}else return;window.dispatchEvent(new Event("resize"))}catch(e){}}
