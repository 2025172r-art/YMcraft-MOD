/* ---- インベントリ・チャットを閉じたらカーソルを自動で固定し直す ---- */
(function(){var want=0,lastEsc=0,other=0,mode="",lk="",lt=0;function cv(){return document.querySelector("canvas._eaglercraftX_canvas_element")}
document.addEventListener("pointerlockchange",function(){if(document.pointerLockElement){want=0}else{if(Date.now()-lastEsc>400){want=1;other=0;mode=(Date.now()-lt<500&&(lk==="/"||lk==="t"||lk==="T"))?"chat":"inv"}}});
function relock(){if(!want||document.pointerLockElement)return;var c=cv();if(c&&c.requestPointerLock){try{var r=c.requestPointerLock();if(r&&r.catch)r.catch(function(){})}catch(e){}}}
window.addEventListener("keydown",function(e){if(!e.isTrusted)return;lk=e.key;lt=Date.now();
 if(e.key==="Escape"){if(want&&!document.pointerLockElement){setTimeout(relock,150)}else{lastEsc=Date.now()}return}
 if(!want)return;
 if(mode==="inv"&&e.code==="KeyE"&&other===0){setTimeout(relock,120);return}
 if(mode==="chat"&&e.key==="Enter"){setTimeout(relock,200);return}
 if(e.key.length===1)other++},true);
})();
</script>
