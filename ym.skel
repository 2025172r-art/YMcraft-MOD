   g[2].forEach(function(t){var lab=nm+" "+t[0];if(qq&&lab.toLowerCase().indexOf(qq)<0&&id.indexOf(qq)<0)return;m++;if(m>lim)return;cmdBtn([lab,t[1](id)],row)})})});
