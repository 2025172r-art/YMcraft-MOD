 n.textContent="ブロックと大きさ(半径)を決めると、自分の足元を中心にした形のコマンドができます。複数行のものは、押すたびに次の行がコピーされます(T → Ctrl+V → Enter を繰り返す)。「消す」は同じ形を空気で置き換えます。";panel.appendChild(n);
 var bar=css(document.createElement("div"),"display:flex;gap:6px;margin-bottom:6px;flex-wrap:wrap;align-items:center");
 var q=css(document.createElement("input"),"flex:1;min-width:150px;padding:6px;font:13px sans-serif");q.placeholder="ブロック(例: 石、ガラス、stone)";q.value=bld.b;
