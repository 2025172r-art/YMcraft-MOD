/* ---- 建築ツール: 球・円柱・ピラミッドなどを fill の連続で作る ---- */
var bld={b:"stone",n:5};
function findBlock(q){q=(q||"").trim().toLowerCase();if(!q)return null;var it=YMD.items||{};if(it[q])return q;var k=Object.keys(it),i;
 for(i=0;i<k.length;i++)if(it[k[i]].toLowerCase()===q)return k[i];
 for(i=0;i<k.length;i++)if(k[i].indexOf(q.replace(/ /g,"_"))===0)return k[i];
 for(i=0;i<k.length;i++)if(it[k[i]].toLowerCase().indexOf(q)>=0||k[i].indexOf(q)>=0)return k[i];return null}
function shapes(B,r){var L={};function F(a,b,c,d,e,f,bl){return "/fill ~"+a+" ~"+b+" ~"+c+" ~"+d+" ~"+e+" ~"+f+" "+bl}
 function R(v){return v<0?"-"+(-v):""+v}function P(v){return v<0?""+v:"+"+v}
 function f6(x1,y1,z1,x2,y2,z2,bl){return "/fill ~"+(x1)+" ~"+(y1)+" ~"+(z1)+" ~"+(x2)+" ~"+(y2)+" ~"+(z2)+" "+bl}
 function make(bl){var o=[];
  o.push(["床("+(2*r+1)+"x"+(2*r+1)+")",[f6(-r,-1,-r,r,-1,r,bl)]]);
  o.push(["箱(中身も詰める)",[f6(-r,0,-r,r,2*r,r,bl)]]);
  o.push(["中空の部屋",[f6(-r,0,-r,r,r+1,r,bl+" hollow")]]);
  o.push(["壁(北側)",[f6(-r,0,-r,r,r,-r,bl)]]);
  o.push(["四角い塔(高さ"+(3*r)+")",[f6(-1,0,-1,1,3*r,1,bl)]]);
  var p=[];for(var k=0;k<=r;k++)p.push(f6(-(r-k),k,-(r-k),r-k,k,r-k,bl));o.push(["ピラミッド",p]);
  var ip=[];for(k=0;k<=r;k++)ip.push(f6(-k,k,-k,k,k,k,bl));o.push(["逆ピラミッド",ip]);
  var hp=[];for(k=0;k<=r;k++){var w=r-k;hp.push(f6(-w,k,-w,w,k,w,bl+(w>1?" outline":"")))}o.push(["中空ピラミッド",hp]);
  var st=[];for(k=0;k<=r;k++)st.push(f6(-r,k,k,r,k,r,bl));o.push(["階段状の山",st]);
  var ci=[];for(var z=-r;z<=r;z++){var h=Math.floor(Math.sqrt(r*r-z*z+0.25));ci.push(f6(-h,-1,z,h,-1,z,bl))}o.push(["円(床)",ci]);
  var cy=[];for(z=-r;z<=r;z++){h=Math.floor(Math.sqrt(r*r-z*z+0.25));cy.push(f6(-h,0,z,h,r*2,z,bl))}o.push(["円柱(高さ"+(2*r+1)+")",cy]);
  var sp=[],dm=[];for(var y=-r;y<=r;y++){var rr=Math.sqrt(r*r-y*y);for(z=-Math.floor(rr);z<=Math.floor(rr);z++){h=Math.floor(Math.sqrt(rr*rr-z*z+0.25));var ln=f6(-h,y+r,z,h,y+r,z,bl);sp.push(ln);if(y>=0)dm.push(ln)}}
  o.push(["球",sp]);o.push(["ドーム(半球)",dm]);return o}
 return make(B)}
