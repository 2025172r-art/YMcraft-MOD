 var box=css(document.createElement("div"),"max-height:min(44vh,320px);overflow:auto;padding-right:4px");panel.appendChild(box);
 function draw(){box.innerHTML="";var qq=bq.trim().toLowerCase(),row=css(document.createElement("div"),"display:flex;flex-wrap:wrap;gap:6px"),m=0,lim=bpage*200;
