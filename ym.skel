["Window","Document","HTMLElement","Element","GlobalEventHandlers"].forEach(function(n){try{var P=window[n]&&window[n].prototype;if(P&&Object.prototype.hasOwnProperty.call(P,"ontouchstart")){delete P.ontouchstart;delete P.ontouchend;delete P.ontouchmove;delete P.ontouchcancel}}catch(e){}});
